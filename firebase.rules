{
  "rules": {
    "chess_games": {
      ".read": true,
      ".write": true,
      "$inviteCode": {
        ".validate": "newData.hasChildren(['invite_code', 'game_state']) && newData.child('invite_code').isString() && newData.child('game_state').isString() && (newData.child('game_state').val() === 'waiting' || newData.child('game_state').val() === 'waiting_for_join' || newData.child('game_state').val() === 'active' || newData.child('game_state').val() === 'finished') && (!newData.hasChild('chain') || (newData.child('chain').isString() && (newData.child('chain').val() === 'sanko' || newData.child('chain').val() === 'base' || newData.child('chain').val() === 'arbitrum')))"
      }
    },
    "leaderboard": {
      ".read": true,
      ".write": true,
      "$walletAddress": {
        ".validate": "newData.hasChildren(['username', 'wins', 'losses', 'draws', 'total_games', 'points']) && newData.child('username').isString() && newData.child('wins').isNumber() && newData.child('losses').isNumber() && newData.child('draws').isNumber() && newData.child('total_games').isNumber() && newData.child('points').isNumber() && newData.child('wins').val() >= 0 && newData.child('losses').val() >= 0 && newData.child('draws').val() >= 0 && newData.child('total_games').val() >= 0 && newData.child('points').val() >= 0"
      }
    },
    "chess_chat": {
      "public": {
        ".read": true,
        ".write": true,
        "messages": {
          "$messageId": {
            ".validate": "newData.hasChildren(['userId', 'walletAddress', 'displayName', 'message', 'timestamp', 'room']) && newData.child('userId').isString() && newData.child('walletAddress').isString() && newData.child('displayName').isString() && newData.child('message').isString() && newData.child('timestamp').isNumber() && newData.child('room').val() === 'public' && newData.child('message').val().length > 0 && newData.child('message').val().length <= 500"
          }
        }
      },
      "private": {
        "$inviteCode": {
          ".read": "auth != null && (data.child('participants').child(auth.uid).exists() || root.child('chess_games').child($inviteCode).child('blue_player').val() === auth.uid || root.child('chess_games').child($inviteCode).child('red_player').val() === auth.uid)",
          ".write": "auth != null && (data.child('participants').child(auth.uid).exists() || root.child('chess_games').child($inviteCode).child('blue_player').val() === auth.uid || root.child('chess_games').child($inviteCode).child('red_player').val() === auth.uid)",
          "messages": {
            "$messageId": {
              ".validate": "newData.hasChildren(['userId', 'walletAddress', 'displayName', 'message', 'timestamp', 'room', 'inviteCode']) && newData.child('userId').isString() && newData.child('walletAddress').isString() && newData.child('displayName').isString() && newData.child('message').isString() && newData.child('timestamp').isNumber() && newData.child('room').val() === 'private' && newData.child('inviteCode').val() === $inviteCode && newData.child('message').val().length > 0 && newData.child('message').val().length <= 500"
            }
          }
        }
      }
    },
    "profiles": {
      ".read": true,
      ".write": true,
      "$walletAddress": {
        ".validate": "(!newData.hasChild('wallet_address') || (newData.child('wallet_address').isString() && newData.child('wallet_address').val() === $walletAddress)) && (!newData.hasChild('username') || (newData.child('username').isString() && newData.child('username').val().length >= 3 && newData.child('username').val().length <= 20)) && (!newData.hasChild('created_at') || newData.child('created_at').isString()) && (!newData.hasChild('updated_at') || newData.child('updated_at').isString())",
        "game_stats": {
          ".validate": "newData.hasChildren(['total_games', 'wins', 'losses', 'draws', 'total_points', 'win_rate']) && newData.child('total_games').isNumber() && newData.child('wins').isNumber() && newData.child('losses').isNumber() && newData.child('draws').isNumber() && newData.child('total_points').isNumber() && newData.child('win_rate').isNumber() && newData.child('total_games').val() >= 0 && newData.child('wins').val() >= 0 && newData.child('losses').val() >= 0 && newData.child('draws').val() >= 0 && newData.child('total_points').val() >= 0 && newData.child('win_rate').val() >= 0"
        },
        "nft_inventory": {
          ".read": true,
          ".write": true
        },
        "profile_picture": {
          ".validate": "!newData.exists() || (newData.hasChildren(['collection', 'token_id', 'image_url']) && newData.child('collection').isString() && newData.child('token_id').isString() && newData.child('image_url').isString())"
        }
      }
    },
    "usernames": {
      ".read": true,
      ".write": true,
      "$username": {
        ".validate": "newData.hasChildren(['wallet_address']) && newData.child('wallet_address').isString() && $username.length >= 3 && $username.length <= 20"
      }
    },
    "world": {
      ".read": true,
      ".write": true
    },
    "clawb": {
      ".read": true,
      ".write": true
    },
    "lawbamp_uploads": {
      ".read": true,
      ".write": false,
      "$entryId": {
        ".validate": "newData.hasChildren(['uploader','title','filename','mime','bytes','duration_sec','created_at','storage_url']) && newData.child('uploader').isString() && newData.child('uploader').val().matches(/^0x[0-9a-fA-F]{40}$/) && newData.child('title').isString() && newData.child('title').val().length > 0 && newData.child('title').val().length <= 120 && newData.child('filename').isString() && newData.child('filename').val().length > 0 && newData.child('filename').val().length <= 120 && newData.child('mime').isString() && (newData.child('mime').val().matches(/^audio\\//) || newData.child('mime').val().matches(/^video\\//)) && newData.child('bytes').isNumber() && newData.child('bytes').val() > 0 && newData.child('duration_sec').isNumber() && newData.child('duration_sec').val() > 0 && newData.child('duration_sec').val() <= 1800 && newData.child('created_at').isNumber() && newData.child('created_at').val() > 0 && newData.child('storage_url').isString() && newData.child('storage_url').val().matches(/^https:\\/\\/.+/)"
      }
    },
    "lawbamp_uploads_by_user": {
      ".read": true,
      ".write": false
    },
    "$other": {
      ".read": false,
      ".write": false
    }
  }
}
