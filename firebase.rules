{
  "rules": {
    "clawb": {
      ".read": false,
      ".write": false,

      "ads": {
        ".read": false,
        ".write": false,

        "sessions": {
          ".indexOn": ["status", "wallet", "updated_at"]
        },
        "playback_ads": {
          ".indexOn": ["status", "approved_at_ms", "first_play_pending", "tier"]
        },
        "intake_notifications": {
          ".indexOn": ["status", "updated_at"]
        },
        "rotation_auctions": {
          ".indexOn": ["status", "ends_at_ms"]
        },
        "tx_index": {
          ".read": false,
          ".write": false
        },
        "notify_retry": {
          ".indexOn": ["created_at"]
        }
      }
    },

    "leaderboard": {
      ".read": true,
      ".indexOn": ["points"],
      "$walletAddress": {
        ".write": true,
        ".validate": "newData.hasChildren(['username', 'wins', 'losses', 'draws', 'total_games', 'points']) && newData.child('username').isString() && newData.child('wins').isNumber() && newData.child('losses').isNumber() && newData.child('draws').isNumber() && newData.child('total_games').isNumber() && newData.child('points').isNumber() && newData.child('wins').val() >= 0 && newData.child('losses').val() >= 0 && newData.child('draws').val() >= 0 && newData.child('total_games').val() >= 0 && newData.child('points').val() >= 0 && (!newData.hasChild('chain_type') || newData.child('chain_type').isString()) && (!newData.hasChild('created_at') || newData.child('created_at').isString()) && (!newData.hasChild('updated_at') || newData.child('updated_at').isString())"
      }
    },

    "profiles": {
      ".read": true,
      "$walletAddress": {
        ".write": true,
        ".validate": "(!newData.hasChild('wallet_address') || (newData.child('wallet_address').isString() && newData.child('wallet_address').val() === $walletAddress)) && (!newData.hasChild('username') || (newData.child('username').isString() && newData.child('username').val().length >= 3 && newData.child('username').val().length <= 20)) && (!newData.hasChild('created_at') || newData.child('created_at').isString()) && (!newData.hasChild('updated_at') || newData.child('updated_at').isString())",
        "game_stats": {
          ".validate": "newData.hasChildren(['total_games', 'wins', 'losses', 'draws', 'total_points', 'win_rate']) && newData.child('total_games').isNumber() && newData.child('wins').isNumber() && newData.child('losses').isNumber() && newData.child('draws').isNumber() && newData.child('total_points').isNumber() && newData.child('win_rate').isNumber() && newData.child('total_games').val() >= 0 && newData.child('wins').val() >= 0 && newData.child('losses').val() >= 0 && newData.child('draws').val() >= 0 && newData.child('total_points').val() >= 0 && newData.child('win_rate').val() >= 0"
        },
        "nft_inventory": {
          ".read": true,
          ".write": true
        },
        "profile_picture": {
          ".validate": "!newData.exists() || (newData.hasChildren(['collection', 'token_id', 'image_url']) && newData.child('collection').isString() && newData.child('token_id').isString() && newData.child('image_url').isString())"
        }
      }
    },

    "usernames": {
      ".read": true,
      ".write": true,
      "$username": {
        ".validate": "newData.hasChildren(['wallet_address']) && newData.child('wallet_address').isString() && $username.length >= 3 && $username.length <= 20"
      }
    },

    "wallet_links": {
      ".read": true,
      ".write": true,
      "$address": {
        ".validate": "newData.hasChildren(['primary_wallet']) && newData.child('primary_wallet').isString()"
      }
    },

    "claims": {
      ".read": false,
      "$claimId": {
        ".write": true,
        ".validate": "newData.hasChildren(['wallet', 'token', 'amount', 'chain', 'status', 'created_at']) && newData.child('wallet').isString() && newData.child('token').isString() && (newData.child('token').val() === 'clawb' || newData.child('token').val() === 'lawb') && newData.child('amount').isNumber() && newData.child('amount').val() > 0 && newData.child('chain').isString() && newData.child('status').isString() && newData.child('created_at').isString()"
      }
    },

    "$other": {
      ".read": false,
      ".write": false
    }
  }
}
