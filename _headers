# Security headers for WebSocket connections and SharedArrayBuffer
/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  
  # Content Security Policy - Allow necessary JavaScript execution
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-eval' 'unsafe-inline' https://cdn.jsdelivr.net https://unpkg.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https:; connect-src 'self' https://*.firebaseio.com https://*.googleapis.com wss://*.firebaseio.com https://*.netlify.app; worker-src 'self' blob:; child-src 'self' blob:; frame-src 'self';
  
  # Required for SharedArrayBuffer (Stockfish WASM)
  Cross-Origin-Embedder-Policy: require-corp
  Cross-Origin-Opener-Policy: same-origin-allow-popups
  
  # Allow WebSocket connections
  Cross-Origin-Resource-Policy: cross-origin
