# Security headers for WebSocket connections and SharedArrayBuffer
/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  
  # Content Security Policy - Block Coinbase analytics
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-eval' 'unsafe-inline' https://cdn.jsdelivr.net https://unpkg.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https:; connect-src 'self' https://*.firebaseio.com https://*.googleapis.com wss://*.firebaseio.com https://*.netlify.app https://*.web3modal.org https://*.walletconnect.org https://*.vercel.app https://*.reown.com https://*.geckoterminal.com https://api.web3modal.org https://pulse.walletconnect.org https://react-tweet.vercel.app; worker-src 'self' blob:; child-src 'self' blob:; frame-src 'self' https://*.geckoterminal.com https://*.web3modal.org;
  
  # Allow WebSocket connections
  Cross-Origin-Resource-Policy: cross-origin

# Chess-specific headers for SharedArrayBuffer support
/chess
  Cross-Origin-Embedder-Policy: require-corp
  Cross-Origin-Opener-Policy: same-origin-allow-popups
