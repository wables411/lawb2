  Referrer-Policy: strict-origin-when-cross-origin
  Cache-Control: public, max-age=0, must-revalidate
  
  # Content Security Policy - Allow all required services
  # frame-ancestors allows Base app and other trusted domains to embed
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-eval' 'unsafe-inline' https://cdn.jsdelivr.net https://unpkg.com https://*.firebaseio.com https://*.googleapis.com https://platform.twitter.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https: blob:; media-src 'self' https: blob:; connect-src 'self' blob: http://127.0.0.1:7243 https://*.firebaseio.com https://*.googleapis.com wss://*.firebaseio.com https://*.netlify.app https://*.web3modal.org https://*.walletconnect.org wss://*.walletconnect.org wss://relay.walletconnect.org https://explorer-api.walletconnect.com https://*.vercel.app https://*.reown.com https://*.geckoterminal.com https://api.web3modal.org https://pulse.walletconnect.org https://react-tweet.vercel.app https://syndication.twitter.com https://cdn.syndication.twimg.com https://mainnet.sanko.xyz https://sanko-arb-sepolia.rpc.caldera.xyz https://sanko-mainnet.calderachain.xyz https://api.scatter.art https://api.opensea.io https://api.etherscan.io https://api.basescan.org https://eth.blockscout.com https://mainnet.helius-rpc.com https://eth.llamarpc.com https://mainnet.base.org https://sepolia.base.org https://base-sepolia-rpc.publicnode.com https://base-mainnet.g.alchemy.com https://eth-mainnet.g.alchemy.com https://*.alchemy.com https://base.gateway.tenderly.co https://base.drpc.org https://arb1.arbitrum.io https://api.mainnet-beta.solana.com https://solana.publicnode.com https://rpc.ankr.com https://testnet.sankoscan.io https://explorer.sanko.xyz https://lawb.xyz https://explorer.lichess.ovh https://cca-lite.coinbase.com https://chess.lawb.xyz https://reef.lawb.xyz https://api-mainnet.magiceden.dev https://dlmm-api.meteora.ag https://www.remilia.net https://*.workers.dev https://*.wormholescan.io https://*.wormhole.com https://api.coingecko.com https://solana-rpc.publicnode.com wss://solana-rpc.publicnode.com https://wormhole-v2-mainnet-api.chainlayer.network https://wormhole-v2-mainnet-api.mcf.rocks https://wormhole-v2-mainnet-api.staking.fund https://explorer-api.mayan.finance; worker-src 'self' blob:; child-src 'self' blob:; frame-src 'self' https://*.firebaseio.com https://*.geckoterminal.com https://*.web3modal.org https://*.walletconnect.org https://platform.twitter.com https://retake.tv; frame-ancestors 'self' https://*.base.org https://*.base.dev https://farcaster.xyz https://*.farcaster.xyz https://warpcast.com https://*.warpcast.com;
  
  # Allow WebSocket connections and external resources
  Cross-Origin-Resource-Policy: cross-origin
  Cross-Origin-Embedder-Policy: unsafe-none

# HTML files - no cache for Base app updates
/index.html
  Cache-Control: no-cache, no-store, must-revalidate
  Pragma: no-cache
  Expires: 0

# JavaScript and CSS assets - cache with hash (Vite handles this)
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Heavy world textures/materials - cache aggressively to reduce repeat bandwidth.
/world-assets/*
  Cache-Control: public, max-age=31536000, immutable

# Reef Run arcade 3D models + character FBX animations. Stable filenames, so cache
# aggressively — without this they fall under the default max-age=0 rule and get
# re-fetched on every play/reload, burning bandwidth credits. Bust by renaming the
# file (e.g. coral2_v2.glb), which is already the project's update pattern.
/arcade-assets/*
  Cache-Control: public, max-age=31536000, immutable

# 3D model payloads and static media should cache aggressively.
/models/*
  Cache-Control: public, max-age=31536000, immutable

/images/*
  Cache-Control: public, max-age=31536000, immutable

/media/*
  Cache-Control: public, max-age=31536000, immutable

# Chess-specific headers
# Note: Stockfish now uses API endpoint (chess.lawb.xyz) instead of WASM
# This avoids COEP/SharedArrayBuffer conflicts with wallet connections
# /chess
#   Cross-Origin-Embedder-Policy: require-corp
#   Cross-Origin-Opener-Policy: same-origin-allow-popups
