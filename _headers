# Security headers for WebSocket connections and SharedArrayBuffer
# Note: X-Frame-Options removed to allow Farcaster/Base mini app embedding
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  
  # Content Security Policy - Allow all required services
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-eval' 'unsafe-inline' https://cdn.jsdelivr.net https://unpkg.com https://*.firebaseio.com https://*.googleapis.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https: blob:; connect-src 'self' https://*.firebaseio.com https://*.googleapis.com wss://*.firebaseio.com https://*.netlify.app https://*.web3modal.org https://*.walletconnect.org wss://*.walletconnect.org wss://relay.walletconnect.org https://explorer-api.walletconnect.com https://*.vercel.app https://*.reown.com https://*.geckoterminal.com https://api.web3modal.org https://pulse.walletconnect.org https://react-tweet.vercel.app https://mainnet.sanko.xyz https://sanko-arb-sepolia.rpc.caldera.xyz https://sanko-mainnet.calderachain.xyz https://api.scatter.art https://api.opensea.io https://api.etherscan.io https://mainnet.helius-rpc.com https://eth.llamarpc.com https://mainnet.base.org https://base-mainnet.g.alchemy.com https://eth-mainnet.g.alchemy.com https://*.alchemy.com https://base.gateway.tenderly.co https://base.drpc.org https://testnet.sankoscan.io https://explorer.sanko.xyz https://lawb.xyz https://explorer.lichess.ovh https://cca-lite.coinbase.com https://chess.lawb.xyz https://farcaster.xyz https://client.farcaster.xyz https://warpcast.com https://client.warpcast.com https://auth.farcaster.xyz; worker-src 'self' blob:; child-src 'self' blob:; frame-src 'self' https://*.geckoterminal.com https://*.web3modal.org https://farcaster.xyz https://warpcast.com;
  
  # Allow WebSocket connections and external resources
  Cross-Origin-Resource-Policy: cross-origin
  Cross-Origin-Embedder-Policy: unsafe-none

