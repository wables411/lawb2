{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "lawb-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "port": 3000,
      "autoPort": true
    },
    {
      "name": "lawb-dist-preview",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["vite", "preview", "--port", "3213", "--strictPort"],
      "port": 3213
    },
    {
      "name": "radbro-dist-preview",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["vite", "preview", "--config", "vite.radbro.config.ts", "--port", "3401", "--strictPort"],
      "port": 3401
    }
  ]
}
