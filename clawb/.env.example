# === Clawb Agent Environment Variables ===
# Copy this file to .env and fill in the values.

# Firebase service account JSON key path
# Download from: Firebase Console → chess-220ee → Project Settings → Service Accounts → Generate New Private Key
FIREBASE_SERVICE_ACCOUNT_PATH=./service-account.json

# Firebase database URL
FIREBASE_DATABASE_URL=https://chess-220ee-default-rtdb.firebaseio.com

# OpenRouter API key (provides access to Claude and other models)
# Get from: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-...

# Clawb's wallet private key (Base chain)
# Wallet address: 0x5bBA58218914F2e9b6b5434e0306fa2c6CA0E429
CLAWB_PRIVATE_KEY=0x...

# Base RPC URL
BASE_RPC_URL=https://mainnet.base.org

# Stockfish API endpoint
STOCKFISH_API_URL=https://chess.lawb.xyz/api/stockfish

# Optional: override default models (defaults to anthropic/claude-3.5-haiku via OpenRouter)
# CLAWB_CHAT_MODEL=anthropic/claude-3.5-haiku
# CLAWB_CHESS_MODEL=anthropic/claude-3.5-haiku

# === Retake.TV Streaming (OBS) ===
# OBS WebSocket URL (default: ws://127.0.0.1:4455)
# OBS_WS_URL=ws://127.0.0.1:4455
# OBS_WS_PASSWORD=

# !eqsource djset — EQ overlay needs an HTTP stream URL to visualize. Set this to the URL DJSET plays from.
# Examples: icecast stream, m3u8, direct mp3 URL. If DJSET is a browser source, use that page's audio URL.
# EQ_DJ_INPUT_NAME=DJSET
# EQ_DJ_STREAM_URL=https://example.com/stream.m3u8
# CLAWB_STREAM_MODEL=anthropic/claude-3.5-haiku

# Clawb World autonomous idle behavior (curious swimming when no viewer input)
# RETAKE_IDLE_BEHAVIOR_ENABLED=1
# RETAKE_IDLE_THRESHOLD_MS=120000   # 2 min no chat before Clawb acts on his own
# RETAKE_IDLE_ACTION_INTERVAL_MS=120000  # every 2 min when idle
# RETAKE_IDLE_LOOK_MAX_INDEX=24     # NFT indices 1..N shuffled into rotation (no repeat until full cycle)

# Bankr wallet identity (public address only)
# BANKR_SOLANA_WALLET_ADDRESS=GDt1ZmAtCfqbK8iFAEyJUCbnu1TPjVeg3HaJ1wKaqhvC

# Retake dedicated Solana wallet config
# RETAKE_SOLANA_WALLET_ADDRESS=<public_wallet_address>
# RETAKE_SOLANA_KEYPAIR_PATH=C:\Users\<you>\lawb2\clawb\credentials\solana\clawb-retake-wallet.json

# === First-Win Bounty Payout Queue ===
# Solana $CLAWB token mint + decimals (5,000,000 whole-token payout)
SOL_CLAWB_MINT=
SOL_CLAWB_DECIMALS=6

# Base Kemonokaki NFT contract/token used for first wagered PVP win bounty
BASE_KEMONOKAKI_CONTRACT=
BASE_KEMONOKAKI_TOKEN_ID=9978

# Solana signer for SPL payouts (set one of the following):
# CLAWB_SOLANA_PRIVATE_KEY=<base58_secret_or_json_array>
# CLAWB_SOLANA_KEYPAIR_PATH=C:\Users\<you>\lawb2\clawb\credentials\solana\clawb-retake-wallet.json

# Queue processor controls
# BOUNTY_PAYOUT_POLL_MS=12000
# BOUNTY_PAYOUT_DRY_RUN=false
# BOUNTY_AUTO_APPROVE=true
